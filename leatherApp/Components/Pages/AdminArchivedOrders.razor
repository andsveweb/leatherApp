@page "/admin/orders/archived"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using leatherApp.Data
@using leatherApp.Models
@inject CartService CartSvc

<PageTitle>Archived Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudText Typo="Typo.h4" Style="font-family:Georgia,serif; color:var(--brand-dark);" Class="mb-4">
        Archived Orders
    </MudText>

    @if (orders == null)
    {
        <MudText>Loading...</MudText>
    }
    else if (orders.Count == 0)
    {
        <MudText Style="color:var(--brand-medium);">No archived orders.</MudText>
    }
    else
    {
        @foreach (var order in orders)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2" Style="background-color:var(--card-bg);">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.h6" Style="color:var(--text-on-card);">Order #@order.OrderId</MudText>
                    <MudChip T="string" Size="Size.Small">@order.Status</MudChip>
                </div>

                <MudText Typo="Typo.body2" Style="color:var(--text-muted);">
                    @order.OrderDate.ToString("d MMM yyyy HH:mm") — @order.Auth0UserId
                </MudText>
                @if (!string.IsNullOrEmpty(order.ShippingName))
                {
                    <MudText Typo="Typo.body2" Style="color:var(--text-on-card);" Class="mt-1">
                        <strong>Ship to:</strong> @order.ShippingName, @order.ShippingAddress, @order.ShippingPostalCode @order.ShippingCity
                    </MudText>
                }

                <MudDivider Class="my-2" />

                @foreach (var line in order.Items)
                {
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2" Style="color:var(--text-on-card);">@line.Product?.Name × @line.Quantity</MudText>
                        <MudText Typo="Typo.body2" Style="color:var(--brand-medium);">@PriceFormatter.Format(line.PriceAtPurchase * line.Quantity)</MudText>
                    </div>
                }

                <MudDivider Class="my-2" />

                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.subtitle2" Style="color:var(--brand-primary);">
                        Total: @PriceFormatter.Format(order.TotalAmount)
                    </MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Unarchive"
                               OnClick="@(() => Unarchive(order.OrderId))">Restore</MudButton>
                </div>
            </MudPaper>
        }
    }

</MudContainer>

@code {
    private List<Order>? orders;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        orders = await CartSvc.GetArchivedOrders();
    }

    private async Task Unarchive(int orderId)
    {
        await CartSvc.SetArchived(orderId, false);
        await Load();
    }
}