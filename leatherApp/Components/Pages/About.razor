@page "/om-oss"
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AboutTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">

    <MudText Typo="Typo.h4" Style="font-family:Georgia,serif; color:var(--brand-dark);" Class="mb-4">
        @L["AboutTitle"]
    </MudText>

    <MudPaper Class="pa-8" Elevation="2" Style="background-color:var(--card-bg);">

        <MudText Typo="Typo.body1" Style="color:var(--text-on-card);" Class="mb-4">
            @L["AboutIntro"]
        </MudText>

        <MudText Typo="Typo.body1" Style="color:var(--text-on-card);" Class="mb-4">
            @L["AboutPatina"]
        </MudText>

        <MudText Typo="Typo.body1" Style="color:var(--text-on-card);" Class="mb-6">
            @L["AboutQuality"]
        </MudText>

        <MudText Typo="Typo.h6" Style="font-family:Georgia,serif; color:var(--brand-dark);" Class="mb-3">
            @L["AboutBenefitsTitle"]
        </MudText>

        <MudList T="string" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                <MudText Style="color:var(--text-on-card);">@L["AboutBenefit1"]</MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                <MudText Style="color:var(--text-on-card);">@L["AboutBenefit2"]</MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                <MudText Style="color:var(--text-on-card);">@L["AboutBenefit3"]</MudText>
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Check" IconColor="Color.Success">
                <MudText Style="color:var(--text-on-card);">@L["AboutBenefit4"]</MudText>
            </MudListItem>
        </MudList>

    </MudPaper>

</MudContainer>