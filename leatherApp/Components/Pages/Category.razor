@page "/category/{CategoryName}"
@using leatherApp.Data
@using leatherApp.Models
@using Microsoft.EntityFrameworkCore
@inject LeatherShopContext Db
@inject IStringLocalizer<SharedResource> L

<PageTitle>@CategoryName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    

    <MudText Typo="Typo.h4" Style="font-family:Georgia,serif; color:var(--brand-dark);" Class="mb-4">
        @L[CategoryName ?? ""]
    </MudText>

    @if (products == null)
    {
        <MudText>Loading...</MudText>
    }
    else if (products.Count == 0)
    {
        <MudText Style="color:var(--brand-medium);">@L["NoProducts"]</MudText>
    }
    else
    {
        <MudGrid>
            @foreach (var product in products)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudLink Href="@($"/product/{product.ProductId}")" Underline="Underline.None">
                        <MudPaper Elevation="2" Style="background-color:var(--card-bg); cursor:pointer; overflow:hidden;">
                            <MudImage Src="@product.ImageUrl" Height="180" Width="100" ObjectFit="ObjectFit.Cover" Class="d-block" Style="width:100%;" />
                            <div class="pa-4">
                                <MudText Typo="Typo.h6" Style="color:var(--text-on-card);">@product.Name</MudText>
                                <MudText Typo="Typo.body2" Style="color:var(--brand-medium);" Class="mb-2">@product.Description</MudText>
                                <MudText Typo="Typo.subtitle1" Style="color:var(--brand-primary); font-weight:500;">@PriceFormatter.Format(product.Price)</MudText>
                            </div>
                        </MudPaper>
                    </MudLink>
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {
    [Parameter]
    public string? CategoryName { get; set; }

    private List<Product>? products;

    protected override async Task OnParametersSetAsync()
    {
        products = await Db.Products
            .Include(p => p.Category)
            .Where(p => p.Category!.Name == CategoryName)
            .ToListAsync();
    }
}